# Resend (https://resend.com) — free tier: 3000/month, 100/day
RESEND_API_KEY=
# Use their shared test sender until you verify your own domain in Resend's dashboard
FROM_EMAIL=onboarding@resend.dev

REQUEST_TIMEOUT_SECONDS=20
